NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://app:app@localhost:5434/app

BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=dev-secret-dev-secret-dev-secret-1234
WEB_ORIGIN=http://localhost:5173

LOG_LEVEL=debug

# Rate limiting (per IP, per minute).
RATE_LIMIT_RPC_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=60
# Optional Upstash Redis for shared limits across instances / Cloudflare isolates.
# UPSTASH_REDIS_REST_URL=https://example.upstash.io
# UPSTASH_REDIS_REST_TOKEN=replace-me

# Email delivery (Resend). Without a key, auth emails are logged locally only.
# RESEND_API_KEY=re_replace-me
EMAIL_FROM=Debate Platform <no-reply@example.com>

# Protects GET /metrics. Without it, /metrics is disabled in production.
# METRICS_TOKEN=replace-with-a-long-random-token
