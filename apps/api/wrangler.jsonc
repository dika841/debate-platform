{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "debate-platform-api",
	"account_id": "f441166e3929e4be7fbbd3174ec4a002",
	"main": "src/worker.ts",
	"compatibility_date": "2026-07-27",
	"compatibility_flags": ["nodejs_compat"],
	"routes": [{ "pattern": "api-debate.randika.dev", "custom_domain": true }],
	"observability": {
		"enabled": true
	},
	"vars": {
		"BETTER_AUTH_URL": "https://api-debate.randika.dev",
		"WEB_ORIGIN": "https://debate.randika.dev",
		"NODE_ENV": "production",
		"CLOUDFLARE": "true"
	}
}
