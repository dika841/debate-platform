# Docker Compose (prod-like) environment
# Copy to .env.docker and adjust before running `docker compose up`.

POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

PUBLIC_WEB_URL=http://localhost:8080
PUBLIC_AUTH_URL=http://localhost:8080

# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=change-me-change-me-change-me-change-me
