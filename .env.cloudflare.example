# Cloudflare Workers deployment values.
# Set secrets with: pnpm --filter @app/api exec wrangler secret put <NAME>

NODE_ENV=production
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
BETTER_AUTH_URL=https://api-debate.randika.dev
BETTER_AUTH_SECRET=replace-with-openssl-rand-hex-32
WEB_ORIGIN=https://debate.randika.dev
LOG_LEVEL=info
CLOUDFLARE=true
RATE_LIMIT_RPC_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=60
# Optional Upstash Redis for cross-isolate rate limits.
# UPSTASH_REDIS_REST_URL=https://example.upstash.io
# UPSTASH_REDIS_REST_TOKEN=replace-me
